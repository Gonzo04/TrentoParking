# Copy to .env and fill in real values before running docker-compose

# MongoDB root user (admin only, never used by the app)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme_root

# MongoDB app user (readWrite on trentoparking db only) — used by the backend
MONGO_APP_USER=trentoparking
MONGO_APP_PASS=changeme_app
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=trentoparking
MONGO_AUTH_DB=trentoparking

# JWT secret for signing access tokens
JWT_SECRET=change_this_to_a_long_random_string

# Backend port
PORT=8080
