# Copiare questo file in .env e compilare i valori reali.
# Il file .env NON deve essere committato.

# Porta del backend Node/Express
PORT=8080

# MongoDB condiviso del progetto.
# In produzione/sviluppo di gruppo usare MongoDB Atlas.
#
# Esempio:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trentoparking?retryWrites=true&w=majority
#
# Se MONGODB_URI non viene impostata, il backend usa il fallback locale:
# mongodb://localhost:27017/trentoparking
MONGODB_URI=

# Segreto per firmare eventuali token JWT.
# Deve essere una stringa lunga e casuale.
JWT_SECRET=change_this_to_a_long_random_string

# Mailjet: credenziali per invio email transazionali
# Ottenute dal pannello Mailjet (API Key e Secret Key)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Indirizzo mittente usato per le email di verifica/reset
# Es. VERIFICA_EMAIL=TrentoParking <trentoparking1@gmail.com>
VERIFICA_EMAIL=